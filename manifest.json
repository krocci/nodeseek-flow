{
  "manifest_version": 3,
  "name": "NodeSeek Flow",
  "version": "0.1.20",
  "description": "首页与评论连续阅读、缓存恢复、主题、热榜和 WebDAV 配置同步。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.nodeseek.com/*",
    "https://nodeseek.com/*",
    "https://api.bimg.eu.org/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "flow-settings.html",
  "action": {
    "default_title": "NodeSeek Flow 设置"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nodeseek.com/*",
        "https://nodeseek.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.nodeseek.com/*",
        "https://nodeseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https:"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": ""
}
